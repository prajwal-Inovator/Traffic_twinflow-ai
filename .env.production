# .env.production
# Copy this file to .env and fill in production values

# MongoDB
MONGO_USER=admin
MONGO_PASS=secure_password_here

# Redis
REDIS_PASS=redis_password_here

# JWT
SECRET_KEY=your_very_long_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
OPENWEATHER_API_KEY=your_openweather_key
TAVILY_API_KEY=your_tavily_key
OPENAQ_API_KEY=your_openaq_key

# n8n
N8N_ENCRYPTION_KEY=your_encryption_key_32_chars

# CORS
CORS_ORIGINS=https://your-frontend-domain.com,https://twinflow.ai

# Optional: Swytchcode
SWYTCHCODE_CLI_PATH=/usr/local/bin/swytchcode

# Debug (false in production)
DEBUG=false