# Copy this file to .env and fill in development values

# MongoDB
MONGO_USER=admin
MONGO_PASS=

# Redis
REDIS_PASS=

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
OPENWEATHER_API_KEY=
TAVILY_API_KEY=
OPENAQ_API_KEY=

# n8n
N8N_ENCRYPTION_KEY=

# CORS
CORS_ORIGINS=https://your-frontend-domain.com,https://twinflow.ai

# Optional: Swytchcode
SWYTCHCODE_CLI_PATH=/usr/local/bin/swytchcode

# Debug (false in production)
DEBUG=false
